<UserControl
    x:Class="GlassRea.App.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:GlassRea.App.Pages">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="20,16">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Devices on your network" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Caption}" />
                </StackPanel>
                <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnScan" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="ScanRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" Foreground="{StaticResource OnAccentBrush}" />
                        <TextBlock x:Name="ScanText" Text="Scan now" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="0,0,0,84">
            <ItemsRepeater x:Name="List">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="300" MinItemHeight="128" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="p:DeviceRow">
                        <Border Style="{StaticResource Card}" Padding="16,14" Opacity="{x:Bind Fade}">
                            <Grid ColumnSpacing="14" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Note}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0" Padding="7,2" CornerRadius="5"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind OsShown}">
                                    <TextBlock Text="{x:Bind Os}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Ip}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Mac}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind First}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{x:Bind Last}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
