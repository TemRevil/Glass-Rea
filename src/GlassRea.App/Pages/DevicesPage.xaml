<UserControl
    x:Class="GlassRea.App.Pages.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:GlassRea.App.Pages">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="20,16">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Devices on your network" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Caption}" />
                </StackPanel>
                <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnScan" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="ScanRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" Foreground="{StaticResource OnAccentBrush}" />
                        <TextBlock x:Name="ScanText" Text="Scan now" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="PublicHint" Grid.Row="1" Style="{StaticResource Card}" Padding="20,14" Visibility="Collapsed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Windows treats this network as public" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="On a public network Glass-Rea doesn't listen for devices announcing their names, so fewer of them are named. If this is your home or work network, set it to Private in Windows settings." />
                </StackPanel>
                <Button Grid.Column="2" Content="Open network settings" Click="OnOpenNetworkSettings" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Padding="0,0,0,84">
            <ItemsRepeater x:Name="List">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="300" MinItemHeight="128" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="p:DeviceItem">
                        <Border Style="{StaticResource Card}" Padding="16,14" Opacity="{x:Bind Row.Fade, Mode=OneWay}">
                            <Grid ColumnSpacing="14" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                                    <FontIcon Glyph="{x:Bind Row.Glyph, Mode=OneWay}" FontSize="18" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Row.Name, Mode=OneWay}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Row.Note, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                    <Border VerticalAlignment="Center" Padding="7,2" CornerRadius="5"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind Row.OsShown, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Row.Os, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Button Tag="{x:Bind}" Click="OnRename" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="Rename" AutomationProperties.Name="Rename this device">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                                <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Row.Ip, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Row.Mac, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Row.First, Mode=OneWay}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{x:Bind Row.Last, Mode=OneWay}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
