<UserControl
    x:Class="GlassRea.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GlassRea.App.Controls">

    <!-- Settings is split into sections, picked at the top. Each section is a few cards; every change saves itself. -->
    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <c:Segmented x:Name="SectionPick" AutomationProperties.Name="Settings sections" />

        <ScrollViewer Grid.Row="1">
            <Grid x:Name="Sections" Padding="0,0,0,90">

                <!-- General -->
                <Grid x:Name="GeneralSection" VerticalAlignment="Top" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7E8;" FontSize="15" /><TextBlock Text="Startup" Style="{StaticResource CardTitle}" /></StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Start with Windows" /><TextBlock x:Name="StartupCaption" Text="Opens when you sign in" Style="{StaticResource Caption}" TextWrapping="Wrap" /></StackPanel>
                                    <ToggleSwitch x:Name="StartupBox" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnStartup" AutomationProperties.Name="Start with Windows" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Start hidden in the tray" /><TextBlock Text="No window at sign-in, just the tray icon" Style="{StaticResource Caption}" /></StackPanel>
                                    <ToggleSwitch x:Name="StartHiddenBox" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnStartup" AutomationProperties.Name="Start hidden in the tray" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Recording runs whether this window is open or not, for what's on under Permissions." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE737;" FontSize="15" /><TextBlock Text="Window" Style="{StaticResource CardTitle}" /></StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Minimize to the tray" /><TextBlock Text="Minimizing hides the window from the taskbar" Style="{StaticResource Caption}" /></StackPanel>
                                    <ToggleSwitch x:Name="MinimizeTrayBox" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnWindowPrefs" AutomationProperties.Name="Minimize to the tray" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Close to the tray" /><TextBlock Text="Closing keeps Glass-Rea in the tray" Style="{StaticResource Caption}" /></StackPanel>
                                    <ToggleSwitch x:Name="CloseTrayBox" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnWindowPrefs" AutomationProperties.Name="Close to the tray" />
                                </Grid>
                            </Border>
                            <TextBlock Text="With Close to the tray off, closing the window quits the app and its notifications. Recording carries on." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" FontSize="15" /><TextBlock Text="Performance" Style="{StaticResource CardTitle}" /></StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Ultra performance" /><TextBlock Text="Solid glass, a plain window and no animations, for the least processor while the window is open" Style="{StaticResource Caption}" TextWrapping="Wrap" /></StackPanel>
                                    <ToggleSwitch x:Name="UltraBox" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnUltra" AutomationProperties.Name="Ultra performance" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel Spacing="10">
                                    <StackPanel><TextBlock Text="Ask Windows for priority" /><TextBlock Text="More processor time when the PC is busy, so recording and live numbers keep up" Style="{StaticResource Caption}" /></StackPanel>
                                    <c:Segmented x:Name="PriorityPick" AutomationProperties.Name="Priority" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="PriorityNote" Style="{StaticResource Caption}" Text="Normal suits most PCs. High can slow games and other apps a little." />
                        </StackPanel>
                    </Border>

                    <!-- What the service may do with its system rights (Controls/PermissionsPanel.cs), and deleting what it recorded. -->
                    <Border x:Name="PermissionsCard" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8D7;" FontSize="15" /><TextBlock Text="Permissions" Style="{StaticResource CardTitle}" /></StackPanel>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="The service runs with system rights and uses them only for what's on here. Turning one off stops it at once; turning off Blocking apps lifts every block." />
                            <c:PermissionsPanel />
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Delete history" /><TextBlock x:Name="DeleteHistoryCaption" Text="Usage, connections, devices and alerts recorded so far. Settings and blocks stay." Style="{StaticResource Caption}" TextWrapping="Wrap" /></StackPanel>
                                    <Button x:Name="DeleteHistoryButton" Grid.Column="1" Content="Delete history" Click="OnDeleteHistory" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Notifications -->
                <Grid x:Name="NotificationsSection" VerticalAlignment="Top" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEA8F;" FontSize="15" /><TextBlock Text="What to tell you about" Style="{StaticResource CardTitle}" /></StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="A new app goes online" /><TextBlock Text="The first time a program uses the internet" Style="{StaticResource Caption}" /></StackPanel>
                                    <ToggleSwitch x:Name="NewAppBox" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnAlerts" AutomationProperties.Name="Alert when a new app goes online" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="A new device joins your network" /><TextBlock Text="A phone, laptop or gadget not seen before" Style="{StaticResource Caption}" /></StackPanel>
                                    <ToggleSwitch x:Name="NewDeviceBox" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnAlerts" AutomationProperties.Name="Alert when a new device joins" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="A device leaves or comes back" /><TextBlock Text="Missing for 15 minutes, then back again" Style="{StaticResource Caption}" /></StackPanel>
                                    <ToggleSwitch x:Name="PresenceBox" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnAlerts" AutomationProperties.Name="Alert when a device leaves or comes back" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Data limit warnings are always on once a limit is set, at 80% and at 100%." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE91C;" FontSize="15" /><TextBlock Text="Windows notifications" Style="{StaticResource CardTitle}" /></StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Show notifications" /><TextBlock Text="When off, alerts are only listed on the Alerts page" Style="{StaticResource Caption}" /></StackPanel>
                                    <ToggleSwitch x:Name="ShowNotifyBox" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnWindowPrefs" AutomationProperties.Name="Show Windows notifications" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Try it" /><TextBlock Text="Each one has a short title and a line on what it means" Style="{StaticResource Caption}" /></StackPanel>
                                    <Button x:Name="TestNotifyButton" Grid.Column="1" Content="Send a test" VerticalAlignment="Center" Click="OnTestNotify" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Windows' Do not disturb and Focus hold them back until you're free." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Data -->
                <Grid x:Name="DataSection" VerticalAlignment="Top" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D2;" FontSize="15" /><TextBlock Text="Data limits" Style="{StaticResource CardTitle}" /></StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Daily limit" /><TextBlock Text="Starts again at midnight" Style="{StaticResource Caption}" /></StackPanel>
                                    <TextBox x:Name="DailyBox" Grid.Column="1" InputScope="Number" TextAlignment="Right" PlaceholderText="None" LostFocus="OnLimits" AutomationProperties.Name="Daily limit in GB" />
                                    <TextBlock Grid.Column="2" Text="GB" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Monthly limit" /><TextBlock x:Name="MonthlyResetText" Text="Starts again on the 1st" Style="{StaticResource Caption}" /></StackPanel>
                                    <TextBox x:Name="MonthlyBox" Grid.Column="1" InputScope="Number" TextAlignment="Right" PlaceholderText="None" LostFocus="OnLimits" AutomationProperties.Name="Monthly limit in GB" />
                                    <TextBlock Grid.Column="2" Text="GB" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="LimitsNote" Style="{StaticResource Caption}" Text="Counts internet traffic on every network together. Leave empty for no limit." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72E;" FontSize="15" /><TextBlock Text="VPN tunnels" Style="{StaticResource CardTitle}" /></StackPanel>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="A VPN such as Cloudflare WARP takes every app's traffic, encrypts it, and sends it again as its own. Glass-Rea already counts each app by itself, so the VPN's copy is the same data twice. It's listed, but never added to your totals." />
                            <TextBox x:Name="TunnelBox" PlaceholderText="warp-svc.exe, wireguard.exe" LostFocus="OnTunnels" AutomationProperties.Name="VPN tunnel programs, comma separated" />
                            <TextBlock x:Name="TunnelNote" Style="{StaticResource Caption}" Text="Program file names, separated by commas." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE787;" FontSize="15" /><TextBlock Text="When usage starts again" Style="{StaticResource CardTitle}" /></StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Monthly reset day" /><TextBlock Text="Match your internet plan's billing day" Style="{StaticResource Caption}" /></StackPanel>
                                    <ComboBox x:Name="MonthDayPick" Grid.Column="1" MinWidth="96" VerticalAlignment="Center" SelectionChanged="OnCycle" AutomationProperties.Name="Monthly reset day" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Weeks start on" /><TextBlock Text="For the Week view and its totals" Style="{StaticResource Caption}" /></StackPanel>
                                    <c:Segmented x:Name="WeekPick" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="CycleNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Days start at midnight. A reset day of 29 to 31 falls on the last day of shorter months." />
                        </StackPanel>
                    </Border>

                    <!-- The networks use is counted on. Rows are built in code (SettingsPage.xaml.cs). -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE701;" FontSize="15" /><TextBlock Text="Networks" Style="{StaticResource CardTitle}" /></StackPanel>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="Use is counted on the network this PC was on, Wi-Fi or wired; with a VPN on, on the network underneath it. Pick one at the top of Overview, Apps or Connections to see only its share." />
                            <StackPanel x:Name="NetworkRows" Spacing="8" />
                            <TextBlock x:Name="NoNetworks" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="No network yet. The one this PC is on shows here within a few seconds." />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Appearance -->
                <Grid x:Name="AppearanceSection" VerticalAlignment="Top" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE790;" FontSize="15" /><TextBlock Text="Appearance" Style="{StaticResource CardTitle}" /></StackPanel>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Theme" /><TextBlock Text="Light, dark, or whatever Windows uses" Style="{StaticResource Caption}" /></StackPanel>
                                    <c:Segmented x:Name="ThemePick" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Accent colour" /><TextBlock Text="Use your Windows accent, or pick one of ours" Style="{StaticResource Caption}" /></StackPanel>
                                        <ToggleSwitch x:Name="FollowBox" Grid.Column="1" OnContent="Follow Windows" OffContent="Follow Windows" MinWidth="0" Toggled="OnFollow" />
                                    </Grid>
                                    <ItemsRepeater x:Name="Swatches">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="110" MinItemHeight="34" MinColumnSpacing="6" MinRowSpacing="6" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- The glass: the tab bar, the rate chip and the chart readouts. Rows are built in code (SettingsPage.xaml.cs). -->
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE81E;" FontSize="15" /><TextBlock Text="Glass" Style="{StaticResource CardTitle}" /></StackPanel>
                                <Button x:Name="ResetGlassButton" Grid.Column="1" Content="Reset glass" Click="OnResetGlass" />
                            </Grid>
                            <Grid x:Name="GlassGrid" ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock x:Name="EffectsNote" Style="{StaticResource Caption}"
                                       Text="With Ultra performance on, or Transparency effects off in Windows settings, the app stays solid whatever these say. Windows sets how strongly the window itself blurs the desktop; Frosting controls the app's own glass." />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- About -->
                <Grid x:Name="AboutSection" VerticalAlignment="Top" ColumnSpacing="12" RowSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <c:LogoMark Width="48" Height="48" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Glass-Rea" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" />
                                    <TextBlock Text="Made by Tem Revil" FontFamily="Segoe UI Variable Display" FontStyle="Italic" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="A personal network monitor for this PC: what uses the internet, how much, and what's on your network." />
                            <HyperlinkButton Content="temrevil.com" NavigateUri="https://temrevil.com" Padding="0" AutomationProperties.Name="Visit temrevil.com" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9F5;" FontSize="15" /><TextBlock Text="Recording service" Style="{StaticResource CardTitle}" /></StackPanel>
                            <TextBlock x:Name="ServiceText" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE895;" FontSize="15" /><TextBlock Text="Updates" Style="{StaticResource CardTitle}" /></StackPanel>
                                    <TextBlock x:Name="UpdateText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="CheckButton" Grid.Column="1" VerticalAlignment="Top" Click="OnCheckUpdates" AutomationProperties.Name="Check for updates now">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing x:Name="CheckRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                                        <TextBlock x:Name="CheckLabel" Text="Check now" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="ReleasePanel" Spacing="10" Visibility="Collapsed">
                                <Border Style="{StaticResource Row}">
                                    <TextBlock x:Name="ReleaseNotes" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxLines="9" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                </Border>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button x:Name="InstallButton" Style="{StaticResource AccentButtonStyle}" Content="Download and install" Click="OnInstallUpdate" />
                                    <ProgressBar x:Name="DownloadBar" Grid.Column="1" VerticalAlignment="Center" Maximum="1" Visibility="Collapsed" />
                                    <HyperlinkButton x:Name="ReleaseLink" Grid.Column="2" Content="Release notes on GitHub" Padding="0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <Border x:Name="AutoUpdateRow" Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Check for updates automatically" /><TextBlock Text="Once a day, with a notification when a new version is out" Style="{StaticResource Caption}" /></StackPanel>
                                    <ToggleSwitch x:Name="AutoUpdateBox" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="OnAutoUpdate" AutomationProperties.Name="Check for updates automatically" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- What went wrong, for sending to the developer. -->
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A5;" FontSize="15" /><TextBlock Text="Logs" Style="{StaticResource CardTitle}" /></StackPanel>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Text="Glass-Rea notes crashes, errors, moments the window stopped responding and anything that was slow, here on this PC. Nothing leaves it unless you send it. If something went wrong, send the logs to temrevil@gmail.com with a line on what happened." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SendLogsButton" Style="{StaticResource AccentButtonStyle}" Click="OnSendLogs">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE715;" FontSize="14" /><TextBlock Text="Email the logs" /></StackPanel>
                                </Button>
                                <Button x:Name="SaveLogsButton" Click="OnSaveLogs">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="14" /><TextBlock Text="Save a copy" /></StackPanel>
                                </Button>
                                <Button Click="OnOpenLogs">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE838;" FontSize="14" /><TextBlock Text="Open the logs folder" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <InfoBar x:Name="LogsBar" IsOpen="False" IsClosable="True" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
