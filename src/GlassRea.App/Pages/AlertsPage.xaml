<UserControl
    x:Class="GlassRea.App.Pages.AlertsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:GlassRea.App.Pages">

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel Spacing="14">
                <TextBlock Text="Alerts" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Glass-Rea stays quiet unless something is worth knowing: an app going online for the first time, a new device on your Wi-Fi, or a data limit getting close." />
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock x:Name="CountText" Style="{StaticResource BigNumber}" /><TextBlock Text="in the list" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,0,6" /></StackPanel>
                </StackPanel>
                <HyperlinkButton Content="Choose which alerts you get" Padding="0" Click="OnSettings" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8,8,8,0">
            <Grid>
                <ListView x:Name="List" SelectionMode="None" Padding="0,0,0,84">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="p:AlertItem">
                            <Grid Padding="4,12" ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
                                    <FontIcon Glyph="{x:Bind Row.Glyph, Mode=OneWay}" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Row.Title, Mode=OneWay}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Row.Body, Mode=OneWay}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Row.When, Mode=OneWay}" Style="{StaticResource Caption}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="Empty" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xEA8F;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No alerts yet" Style="{StaticResource CardTitle}" HorizontalAlignment="Center" />
                    <TextBlock Text="New apps, new devices and data limits will show up here." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
