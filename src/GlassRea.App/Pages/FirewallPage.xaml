<UserControl
    x:Class="GlassRea.App.Pages.FirewallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GlassRea.App.Controls"
    xmlns:p="using:GlassRea.App.Pages">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="20,16">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Block an app's internet" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Text="Turn an app off to block it in Windows Firewall. It keeps working offline; turn it back on any time." />
                </StackPanel>
                <AutoSuggestBox x:Name="Search" Grid.Column="1" Width="280" PlaceholderText="Find an app" QueryIcon="Find" TextChanged="OnSearch" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,8,8,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Margin="6,4,6,8" />
                <!-- Not virtualized: recycled rows would fire their switches with another app's state. -->
                <ListView x:Name="Apps" Grid.Row="1" SelectionMode="None" Padding="0,0,0,84">
                    <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="p:FirewallItem">
                            <Grid Padding="2,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <c:AppIconView AppPath="{x:Bind Row.Path, Mode=OneWay}" AppName="{x:Bind Row.Name, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Row.Name, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Row.Sub, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Row.Total, Mode=OneWay}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="3" IsOn="{x:Bind Row.Allowed, Mode=OneWay}" IsEnabled="{x:Bind Row.CanBlock, Mode=OneWay}" Tag="{x:Bind}" Toggled="OnToggle"
                                              OnContent="Online" OffContent="Blocked" MinWidth="0" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
