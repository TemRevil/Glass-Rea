<UserControl
    x:Class="GlassRea.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GlassRea.App.Controls"
    xmlns:p="using:GlassRea.App.Pages">

    <Grid ColumnSpacing="12" RowSpacing="12" Padding="0,0,0,84">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Where the data went: one sentence, then the chart. -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="22,20,22,16">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="PeriodText" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="Headline" Style="{StaticResource Headline}">
                            <Run x:Name="HeadA" /><Run x:Name="HeadTotal" Foreground="{StaticResource AccentBrush}" /><Run x:Name="HeadB" />
                        </TextBlock>
                    </StackPanel>
                    <ContentPresenter x:Name="PickerHost" Grid.Column="1" />
                </Grid>
                <c:BarChart x:Name="Chart" Grid.Row="1" MinHeight="180" />
                <StackPanel Grid.Row="2" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" /><TextBlock x:Name="DownText" Style="{StaticResource Caption}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="{StaticResource UpBrush}" VerticalAlignment="Center" /><TextBlock x:Name="UpText" Style="{StaticResource Caption}" /></StackPanel>
                        <TextBlock x:Name="TunnelText" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <TextBlock x:Name="HistoryNote" Style="{StaticResource Caption}" Visibility="Collapsed" Opacity="0.85" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top apps for the same period. -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16,18,10">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="TopTitle" Text="Top apps" Style="{StaticResource CardTitle}" />
                    <HyperlinkButton Content="See all" HorizontalAlignment="Right" Padding="6,2" Click="OnSeeAll" />
                </Grid>
                <ItemsControl x:Name="TopApps" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="p:AppRow">
                            <Grid ColumnSpacing="10" Padding="0,7" Opacity="{x:Bind Dim}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <c:AppIconView AppPath="{x:Bind Path}" AppName="{x:Bind Name}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <Border Visibility="{x:Bind TunnelTag}" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" CornerRadius="4" Padding="5,0">
                                            <TextBlock Text="VPN tunnel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <c:ShareBar Value="{x:Bind Share}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Total}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoApps" Grid.Row="1" Style="{StaticResource Muted}" Text="No app has used the internet in this period." Visibility="Collapsed" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Right now -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel Spacing="8">
                <TextBlock Text="Right now" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="NowText" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                <TextBlock x:Name="NowMore" Style="{StaticResource Caption}" />
            </StackPanel>
        </Border>

        <!-- This month against the limit -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="This month" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="LimitText" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>
                <Grid>
                    <TextBlock x:Name="MonthText" Style="{StaticResource BigNumber}" />
                    <TextBlock x:Name="LeftText" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
                <ProgressBar x:Name="MonthBar" Maximum="1" Visibility="Collapsed" />
                <TextBlock x:Name="MonthNote" Style="{StaticResource Caption}" />
            </StackPanel>
        </Border>

        <!-- Latest alerts -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel Spacing="8">
                <TextBlock Text="Alerts" Style="{StaticResource CardTitle}" />
                <StackPanel x:Name="AlertList" Spacing="10" />
                <TextBlock x:Name="NoAlerts" Text="Nothing new. You'll hear about new apps, new devices and limits here." Style="{StaticResource Caption}" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
