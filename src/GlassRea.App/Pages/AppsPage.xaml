<UserControl
    x:Class="GlassRea.App.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GlassRea.App.Controls"
    xmlns:p="using:GlassRea.App.Pages">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="20,16">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PeriodText" Style="{StaticResource Caption}" />
                    <TextBlock Text="Every app that used the internet" Style="{StaticResource PageTitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Total" Style="{StaticResource Caption}" /><TextBlock x:Name="TotalText" Style="{StaticResource BigNumber}" FontSize="22" /></StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Downloaded" Style="{StaticResource Caption}" /><TextBlock x:Name="DownText" Style="{StaticResource BigNumber}" FontSize="22" Foreground="{StaticResource AccentBrush}" /></StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="Uploaded" Style="{StaticResource Caption}" /><TextBlock x:Name="UpText" Style="{StaticResource BigNumber}" FontSize="22" Foreground="{StaticResource UpBrush}" /></StackPanel>
                <ContentPresenter x:Name="PickerHost" Grid.Column="4" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,8,8,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Padding="14,4,30,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="App" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="2" Text="Download" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Upload" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Total" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>
                <ListView x:Name="List" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnOpen" Padding="0,0,0,84">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="p:AppItem">
                            <Grid Padding="2,9" ColumnSpacing="12" Opacity="{x:Bind Row.Dim, Mode=OneWay}" ToolTipService.ToolTip="Open its connections">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                <c:AppIconView AppPath="{x:Bind Row.Path, Mode=OneWay}" AppName="{x:Bind Row.Name, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Row.Name, Mode=OneWay}" />
                                        <Border Visibility="{x:Bind Row.TunnelTag, Mode=OneWay}" BorderThickness="1" BorderBrush="{StaticResource CardStrokeBrush}" CornerRadius="4" Padding="5,0">
                                            <TextBlock Text="VPN tunnel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Row.Sub, Mode=OneWay}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <c:ShareBar Value="{x:Bind Row.Share, Mode=OneWay}" Margin="0,3,0,0" MaxWidth="420" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Row.Down, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Row.Up, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Row.Total, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="Empty" Grid.Row="1" Text="No app has used the internet in this period." Style="{StaticResource Muted}" Margin="14,8" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
