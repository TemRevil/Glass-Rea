<Window
    x:Class="GlassRea.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GlassRea.App.Controls"
    Title="Glass-Rea">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the logo, the name, and what the service is doing. Caption buttons are Windows' own. -->
        <Grid x:Name="TitleBar" Padding="14,0,150,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:LogoMark Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Glass-Rea" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- The live strip runs under the title bar on every page. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Height="76" Margin="14,0,14,0">
            <Grid>
                <c:LiveGraph x:Name="Pulse" Margin="0,14,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="7" Margin="16,12,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Live, last 2 minutes" Style="{StaticResource Caption}" />
                </StackPanel>
                <c:Glass x:Name="RatesGlass" Refracts="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" CornerRadius="16" Padding="16,8"
                         SmoothWidth="True" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="22">
                        <Grid ColumnSpacing="8" RowSpacing="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="DownRate" Grid.Column="1" Text="0 B/s" FontFamily="Segoe UI Variable Display" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Download" Style="{StaticResource Caption}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource UpBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpRate" Grid.Column="1" Text="0 B/s" FontFamily="Segoe UI Variable Display" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Upload" Style="{StaticResource Caption}" />
                        </Grid>
                    </StackPanel>
                </c:Glass>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid x:Name="PageHost" Margin="14,12,14,0" />
            <Grid x:Name="Ghost" IsHitTestVisible="False" />
            <!-- Runs in the gap above the page while a page gets ready the first time. -->
            <ProgressBar x:Name="Loading" IsIndeterminate="True" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                         VerticalAlignment="Top" Margin="34,4,34,0" AutomationProperties.Name="Loading the page">
                <ProgressBar.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></ProgressBar.OpacityTransition>
            </ProgressBar>

            <InfoBar x:Name="Offline" IsOpen="False" IsClosable="False" Severity="Warning" Margin="14,12,14,0" VerticalAlignment="Top"
                     Title="The Glass-Rea service isn't running"
                     Message="Nothing is being recorded right now. It starts with Windows; if it stays stopped, run the installer again." />

            <!-- The floating bar: one glass capsule of tabs, and a separate round button for light and dark. -->
            <StackPanel x:Name="Dock" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                <c:Glass x:Name="TabsGlass" Padding="4">
                    <Grid>
                        <Border x:Name="Lens" HorizontalAlignment="Left" CornerRadius="17" Background="{StaticResource InkBrush}"
                                BorderThickness="1" BorderBrush="{StaticResource GlassRimBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <CompositeTransform x:Name="LensMove" />
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="2" />
                    </Grid>
                </c:Glass>
                <c:Glass x:Name="ThemeGlass" Width="46" Height="46" Padding="0" Pressable="True">
                    <Button x:Name="ThemeButton" Style="{StaticResource TabButton}" Padding="0" Width="46" Height="46"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" Click="OnThemeClick"
                            ToolTipService.ToolTip="Switch between light and dark" AutomationProperties.Name="Switch between light and dark">
                        <Grid>
                            <FontIcon x:Name="SunIcon" Glyph="&#xE706;" FontSize="17" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><CompositeTransform /></FontIcon.RenderTransform></FontIcon>
                            <FontIcon x:Name="MoonIcon" Glyph="&#xE708;" FontSize="16" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><CompositeTransform /></FontIcon.RenderTransform></FontIcon>
                        </Grid>
                    </Button>
                </c:Glass>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
