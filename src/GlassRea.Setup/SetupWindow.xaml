<Window
    x:Class="GlassRea.Setup.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GlassRea.App.Controls"
    Title="Glass-Rea Setup">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="16,0,100,0" ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:LogoMark Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Glass-Rea Setup" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Padding="16,4,16,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Who this is: the mark, breathing slowly on the window glass, the name, and the signature. -->
            <Grid x:Name="Identity" Padding="20,26,8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Width="132" Height="132" HorizontalAlignment="Left" Margin="-22,-22,0,0">
                    <Ellipse x:Name="Glow" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop x:Name="GlowCenter" Offset="0" Color="#600F62D6" />
                                <GradientStop Offset="1" Color="#000F62D6" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <c:LogoMark x:Name="Logo" Width="84" Height="84" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="Names" Grid.Row="1" Spacing="6" Margin="0,4,0,0">
                    <TextBlock Text="Glass-Rea" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="See what every app does with your internet." Style="{StaticResource Body}" MaxWidth="230" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel x:Name="Signature" Grid.Row="3" Spacing="2">
                    <TextBlock Text="Made by Tem Revil" FontFamily="Segoe UI Variable Display" FontStyle="Italic" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="30,28,26,24">
                <Grid x:Name="Pages">

                    <!-- Install or update -->
                    <Grid x:Name="WelcomePage" RowSpacing="6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="WelcomeTitle" Style="{StaticResource Heading}" Text="Install Glass-Rea" />
                        <TextBlock x:Name="WelcomeBody" Grid.Row="1" Style="{StaticResource Body}"
                                   Text="It records how much each app uses the internet, even while its window is closed, and lets you cut any app off with one switch." />
                        <StackPanel Grid.Row="2" Spacing="8" Margin="0,18,0,0">
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Start with Windows" />
                                        <TextBlock Text="Opens quietly in the tray when you sign in" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartToggle" Grid.Column="1" IsOn="True" OnContent="" OffContent="" MinWidth="0"
                                                  AutomationProperties.Name="Start with Windows" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Installs to" />
                                        <TextBlock x:Name="InstallPathText" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="InstallPathProblem" Style="{StaticResource Caption}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Button x:Name="ChangeFolderButton" Grid.Column="1" Content="Change" Style="{StaticResource FooterButton}" VerticalAlignment="Center" Click="OnChangeFolder"
                                            AutomationProperties.Name="Change install folder" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <StackPanel>
                                    <TextBlock Text=".NET 10" />
                                    <TextBlock x:Name="RuntimeText" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Style="{StaticResource Footer}" Margin="0,16,0,0">
                            <Button Content="Cancel" Style="{StaticResource FooterButton}" Click="OnClose" />
                            <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryButton}" Click="OnInstall" />
                        </StackPanel>
                    </Grid>

                    <!-- Remove -->
                    <Grid x:Name="RemovePage" RowSpacing="6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Heading}" Text="Remove Glass-Rea" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Body}"
                                   Text="This removes the app, its recording service, and every firewall block it made, so no app stays cut off." />
                        <StackPanel Grid.Row="2" Spacing="8" Margin="0,18,0,0">
                            <Border Style="{StaticResource Row}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Keep my usage history" />
                                        <TextBlock x:Name="KeepText" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="KeepToggle" Grid.Column="1" IsOn="True" OnContent="" OffContent="" MinWidth="0"
                                                  AutomationProperties.Name="Keep my usage history" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Style="{StaticResource Footer}" Margin="0,16,0,0">
                            <Button Content="Cancel" Style="{StaticResource FooterButton}" Click="OnClose" />
                            <Button Content="Remove" Style="{StaticResource PrimaryButton}" Click="OnRemove" />
                        </StackPanel>
                    </Grid>

                    <!-- Working -->
                    <Grid x:Name="ProgressPage" RowSpacing="6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ProgressTitle" Style="{StaticResource Heading}" Text="Installing" />
                        <TextBlock x:Name="ProgressStatus" Grid.Row="1" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <ProgressBar x:Name="Bar" Grid.Row="2" Maximum="1000" Margin="0,14,0,0" />
                        <StackPanel x:Name="StepList" Grid.Row="3" Spacing="4" Margin="0,22,0,0" />
                    </Grid>

                    <!-- Finished -->
                    <Grid x:Name="DonePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="8" Margin="0,0,0,24">
                            <Grid x:Name="DoneBadge" Width="60" Height="60" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Ellipse Fill="{StaticResource AccentBrush}" />
                                <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="{StaticResource OnAccentBrush}" />
                            </Grid>
                            <TextBlock x:Name="DoneTitle" Style="{StaticResource Heading}" />
                            <TextBlock x:Name="DoneBody" Style="{StaticResource Body}" />
                            <StackPanel x:Name="AfterOptions" Margin="0,10,0,0">
                                <CheckBox x:Name="OpenAppCheck" Content="Open Glass-Rea now" IsChecked="True" />
                                <CheckBox x:Name="OpenSiteCheck" IsChecked="True" AutomationProperties.Name="Visit temrevil.com">
                                    <TextBlock>Visit <Run Text="temrevil.com" FontWeight="SemiBold" /></TextBlock>
                                </CheckBox>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Style="{StaticResource Footer}">
                            <Button x:Name="FinishButton" Content="Finish" Style="{StaticResource PrimaryButton}" Click="OnFinish" />
                        </StackPanel>
                    </Grid>

                    <!-- Failed -->
                    <Grid x:Name="ErrorPage" RowSpacing="6" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ErrorTitle" Style="{StaticResource Heading}" />
                        <TextBlock x:Name="ErrorText" Grid.Row="1" Style="{StaticResource Body}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="ErrorLog" Grid.Row="2" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" Margin="0,10,0,0" />
                        <StackPanel Grid.Row="3" Style="{StaticResource Footer}">
                            <Button Content="Close" Style="{StaticResource FooterButton}" Click="OnClose" />
                            <Button Content="Try again" Style="{StaticResource PrimaryButton}" Click="OnRetry" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
