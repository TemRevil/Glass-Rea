<Application
    x:Class="GlassRea.Setup.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The app's shared brushes; Appearance (linked from the app) sets them for the theme and palette. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#0F62D6" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#290F62D6" />
            <SolidColorBrush x:Key="UpBrush" Color="#B5472F" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="White" />
            <SolidColorBrush x:Key="CardBrush" Color="#8FFFFFFF" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="RowBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="GlassTintBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="InkBrush" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="EdgeBrush" Color="#99F3F3F3" />
            <SolidColorBrush x:Key="GlowBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="TextBrush" Color="White" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="SelectedFillBrush" Color="#0FFFFFFF" />
            <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#5B9BFF" />
                <GradientStop Offset="1" Color="#0A3F9E" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#F2FFFFFF" />
                <GradientStop Offset="0.5" Color="#0AFFFFFF" />
                <GradientStop Offset="1" Color="#60FFFFFF" />
            </LinearGradientBrush>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
            <Style x:Key="Row" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource RowBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="14,11" />
            </Style>
            <Style x:Key="Heading" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="21" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Footer" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Spacing" Value="8" />
            </Style>
            <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Padding" Value="16,6" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="Padding" Value="16,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
